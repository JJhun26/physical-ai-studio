<?xml version="1.0" encoding="utf-8"?>
<!--
  uArm leader (LeRobot-Anything-U-Arm, Zhonglin servo "Config2" / UR5 build).

  PLACEHOLDER KINEMATICS. Primitive geometry only, no external meshes, so the
  studio viewer has something to draw and animate for j1..j6 before the real
  Config2 model is imported. Link lengths approximate the overall scale of
  mechanical/Zhonglin_servo/Config2_STL (~190 x 274 x 322 mm bounding box in a
  folded pose); the chain is the UR5-style layout that config is built around:
  j1 base yaw, j2/j3/j4 parallel pitch, j5 wrist yaw, j6 tool roll.

  The joint ORIGINS AND AXES ARE NOT MEASURED. Config2.STEP stores the assembly
  in a folded pose and carries no mates, so per-joint frames cannot be recovered
  from it; no DH parameters exist in the uArm, VLA or studio repos. Anything that
  needs true leader geometry (retargeting, collision, calibration) must not read
  it from this file. Replacing it: keep the j1..j6 joint names (the catalog
  entry in robots/catalog/uarm.py maps j{n}.pos to j{n}), and keep every revolute
  limit wide, because the leader publishes FOLLOWER DEGREES that the UI viewer
  feeds to setJointValue as degrees (robot-models-context.tsx); a tighter limit
  silently clamps the pose. +/-360 deg (2*pi) covers the FR5's widest joint --
  j2 and j4 reach -263 deg -- with room to spare. These are display bounds for a
  stub model, not physical limits of the leader.
-->
<robot name="uarm_leader">

  <material name="uarm_body">
    <color rgba="0.27 0.30 0.35 1.0" />
  </material>
  <material name="uarm_joint">
    <color rgba="0.85 0.45 0.10 1.0" />
  </material>
  <material name="uarm_handle">
    <color rgba="0.15 0.16 0.18 1.0" />
  </material>

  <!-- ==== base ==== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.04" />
      </geometry>
      <material name="uarm_body" />
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <mass value="0.60" />
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0009" />
    </inertial>
  </link>

  <!-- ==== j1: base yaw ==== -->
  <joint name="j1" type="revolute">
    <origin xyz="0 0 0.04" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="shoulder_link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.2832" upper="6.2832" effort="10" velocity="3.14" />
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.036" length="0.06" />
      </geometry>
      <material name="uarm_joint" />
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.036" length="0.06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <mass value="0.30" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
    </inertial>
  </link>

  <!-- ==== j2: shoulder pitch ==== -->
  <joint name="j2" type="revolute">
    <origin xyz="0 0 0.06" rpy="0 0 0" />
    <parent link="shoulder_link" />
    <child link="upperarm_link" />
    <axis xyz="0 1 0" />
    <limit lower="-6.2832" upper="6.2832" effort="10" velocity="3.14" />
  </joint>

  <link name="upperarm_link">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.045 0.045 0.14" />
      </geometry>
      <material name="uarm_body" />
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.045 0.045 0.14" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0" />
      <mass value="0.35" />
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <!-- ==== j3: elbow pitch ==== -->
  <joint name="j3" type="revolute">
    <origin xyz="0 0 0.14" rpy="0 0 0" />
    <parent link="upperarm_link" />
    <child link="forearm_link" />
    <axis xyz="0 1 0" />
    <limit lower="-6.2832" upper="6.2832" effort="10" velocity="3.14" />
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <geometry>
        <box size="0.038 0.038 0.13" />
      </geometry>
      <material name="uarm_joint" />
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <geometry>
        <box size="0.038 0.038 0.13" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.00006" />
    </inertial>
  </link>

  <!-- ==== j4: wrist pitch ==== -->
  <joint name="j4" type="revolute">
    <origin xyz="0 0 0.13" rpy="0 0 0" />
    <parent link="forearm_link" />
    <child link="wrist1_link" />
    <axis xyz="0 1 0" />
    <limit lower="-6.2832" upper="6.2832" effort="10" velocity="3.14" />
  </joint>

  <link name="wrist1_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.026" length="0.05" />
      </geometry>
      <material name="uarm_body" />
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.026" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
    </inertial>
  </link>

  <!-- ==== j5: wrist yaw ==== -->
  <joint name="j5" type="revolute">
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <parent link="wrist1_link" />
    <child link="wrist2_link" />
    <axis xyz="0 0 1" />
    <limit lower="-6.2832" upper="6.2832" effort="10" velocity="3.14" />
  </joint>

  <link name="wrist2_link">
    <visual>
      <origin xyz="0 0 0.022" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.024" length="0.044" />
      </geometry>
      <material name="uarm_joint" />
    </visual>
    <collision>
      <origin xyz="0 0 0.022" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.024" length="0.044" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.022" rpy="0 0 0" />
      <mass value="0.10" />
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004" />
    </inertial>
  </link>

  <!-- ==== j6: tool roll (360 deg servo on the real leader) ==== -->
  <joint name="j6" type="revolute">
    <origin xyz="0 0 0.044" rpy="0 0 0" />
    <parent link="wrist2_link" />
    <child link="handle_link" />
    <axis xyz="0 1 0" />
    <limit lower="-6.2832" upper="6.2832" effort="10" velocity="3.14" />
  </joint>

  <!-- Trigger handle: the operator grip, drawn as a stub grip + trigger nub. -->
  <link name="handle_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.036 0.05 0.08" />
      </geometry>
      <material name="uarm_handle" />
    </visual>
    <visual>
      <origin xyz="0 -0.038 0.03" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.026 0.03" />
      </geometry>
      <material name="uarm_joint" />
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.036 0.05 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <mass value="0.18" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00006" />
    </inertial>
  </link>

</robot>
